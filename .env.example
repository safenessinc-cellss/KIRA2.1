# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server-only credentials. Set real values in Vercel Environment Variables;
# never commit a populated .env file.
FIREBASE_SERVICE_ACCOUNT_JSON="REPLACE_WITH_SERVER_SERVICE_ACCOUNT_JSON"
FIREBASE_STORAGE_BUCKET="REPLACE_WITH_FIREBASE_STORAGE_BUCKET"
KIRA_APP_URL="https://kira.coach"

# 32 random bytes, encoded as base64 (AES-256-GCM for encrypted payment gateway secrets).
KIRA_CONFIG_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"

# At least 32 random characters; HMAC-SHA256 certificate signing.
KIRA_CERTIFICATE_SIGNING_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# Optional legacy fallback during migration; prefer encrypted values in the Admin Payments Center.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# CRM PII encryption: 32 random bytes (base64 or 64 hex chars); server-only.
KIRA_CRM_PII_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"
