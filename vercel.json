{
  "version": 2,
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.ts",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups"
      }
    },
    {
      "handle": "filesystem",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups"
      }
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
