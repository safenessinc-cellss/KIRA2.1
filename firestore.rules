// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: userId (matches Firebase Auth UID)
// Fields:
//   - uid: string (required)
//   - email: string (required)
//   - displayName: string (optional)
//   - photoURL: string (optional)
//   - role: string (required, 'admin', 'coach', or 'alumno')
//   - approvalStatus: string (optional, 'pending', 'approved', 'rejected')
//   - createdAt: timestamp (required, immutable)
//
// Collection: courses
// Document ID: courseId
// Fields:
//   - title: string (required)
//   - description: string (optional)
//   - price: number (required)
//   - coachId: string (required, immutable)
//   - status: string (required, 'draft', 'pending', 'published')
//   - bannerUrl: string (optional)
//   - createdAt: timestamp (required, immutable)
//
// Collection: enrollments
// Document ID: enrollmentId
// Fields:
//   - userId: string (required, immutable)
//   - courseId: string (required, immutable)
//   - progress: number (required)
//   - createdAt: timestamp (required, immutable)
//
// Collection: journals
// Document ID: journalId
// Fields:
//   - userId: string (required, immutable)
//   - content: string (required)
//   - sentiment: string (optional)
//   - createdAt: timestamp (required, immutable)
//
// Collection: reviews
// Document ID: reviewId
// Fields:
//   - courseId: string (required, immutable)
//   - userId: string (required, immutable)
//   - rating: number (required, 1-5)
//   - comment: string (optional)
//   - status: string (required, 'published', 'hidden')
//   - createdAt: timestamp (required, immutable)
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isDocOwner(userIdField) {
      return isAuthenticated() && request.auth.uid == userIdField;
    }
    
    function isCurrentUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email == "safeness.c.a@gmail.com"
        && request.auth.token.email_verified == true;
    }
    
    function isKiraOwner() {
      return isAuthenticated() && request.auth.token.email == "safeness.c.a@gmail.com" && request.auth.token.email_verified == true;
    }

    function isKiraStaffAdmin() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isApprovedCoach() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach' &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvalStatus == 'approved';
    }

    function hasActiveCoachMembership() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isApprovedCoach()
        && profile.membershipStatus == 'active'
        && (!('membershipExpiresAt' in profile) || profile.membershipExpiresAt > request.time);
    }
    
    function isCompanyAdmin(companyId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['hr_admin', 'company_admin'];
    }

    function isCompanyMember(companyId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
        && exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }

    function hasOnlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }
    
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }
    
    // ===============================================================
    // Domain Validators
    // ===============================================================
    
    function isValidUser() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['uid', 'email', 'displayName', 'name', 'photoURL', 'photoUrl', 'role', 'approvalStatus', 'points', 'theme', 'isEmailVerified', 'staffPermissions', 'lastLoginAt', 'lastActivityAt', 'createdAt', 'specialty', 'bio', 'aiFeedback', 'registeredByCoach', 'status', 'membershipStatus', 'membershipPaidAt', 'socialLinks', 'specialties', 'calendlyUrl', 'experienceLevel', 'languages', 'welcomeVideoUrl', 'rating', 'studentCount', 'mediaItems', 'updatedAt', 'manualActiveStudents', 'manualAvgProgress', 'manualRecentSessions', 'hasCompletedOnboarding', 'companyId', 'companyName', 'department', 'jobTitle', 'employeeCode', 'organizationId', 'tenantId']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['admin', 'coach', 'alumno', 'hr_admin', 'company_admin', 'company_member'] &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('approvalStatus' in data) || data.approvalStatus in ['pending', 'approved', 'rejected']) &&
             (!('points' in data) || (data.points is number && data.points >= 0)) &&
             (!('hasCompletedOnboarding' in data) || data.hasCompletedOnboarding is bool) &&
             (!('theme' in data) || data.theme is string) &&
             (!('isEmailVerified' in data) || data.isEmailVerified is bool) &&
             (!('staffPermissions' in data) || data.staffPermissions is list) &&
             (!('lastLoginAt' in data) || data.lastLoginAt is timestamp) &&
             (!('lastActivityAt' in data) || data.lastActivityAt is timestamp) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('name' in data) || (data.name is string && data.name.size() < 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 1000000)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() < 1000000)) &&
             (!('specialty' in data) || (data.specialty is string && data.specialty.size() < 200)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() < 10000)) &&
             (!('aiFeedback' in data) || data.aiFeedback is map) &&
             (!('socialLinks' in data) || data.socialLinks is map) &&
             (!('specialties' in data) || data.specialties is list) &&
             (!('calendlyUrl' in data) || data.calendlyUrl is string) &&
             (!('experienceLevel' in data) || data.experienceLevel is string) &&
             (!('languages' in data) || data.languages is string) &&
             (!('welcomeVideoUrl' in data) || data.welcomeVideoUrl is string) &&
             (!('rating' in data) || data.rating is number) &&
             (!('studentCount' in data) || data.studentCount is number) &&
             (!('mediaItems' in data) || data.mediaItems is list) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp) &&
             (!('manualActiveStudents' in data) || data.manualActiveStudents is number) &&
             (!('manualAvgProgress' in data) || data.manualAvgProgress is number) &&
             (!('manualRecentSessions' in data) || data.manualRecentSessions is number);
    }

    function isValidMessage() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['chatId', 'senderId', 'senderName', 'content', 'createdAt', 'participants']) &&
             data.chatId is string && data.senderId is string &&
             (!('senderName' in data) || data.senderName is string) &&
             data.participants is list && data.participants.size() == 2 &&
             request.auth.uid in data.participants &&
             data.participants[0] < data.participants[1] &&
             data.chatId == data.participants[0] + '_' + data.participants[1] &&
             data.content is string && data.content.size() > 0 && data.content.size() < 10000 &&
             data.createdAt is timestamp;
    }

    function isValidContract() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['coachId', 'title', 'status', 'fileUrl', 'expiresAt', 'createdAt']) &&
             data.coachId is string && data.title is string &&
             data.status in ['active', 'expired', 'pending'] &&
             data.createdAt is timestamp &&
             (!('fileUrl' in data) || data.fileUrl is string) &&
             (!('expiresAt' in data) || data.expiresAt is timestamp);
    }
    
    function isValidCourse() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['title', 'description', 'price', 'coachId', 'status', 'bannerUrl', 'createdAt', 'updatedAt', 'hours', 'coachName', 'studentsCount']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.price is number && data.price >= 0 &&
             data.coachId is string &&
             data.status in ['draft', 'pending', 'published'] &&
             data.createdAt is timestamp &&
             (!('updatedAt' in data) || data.updatedAt is timestamp) &&
             (!('description' in data) || (data.description is string && data.description.size() < 10000)) &&
             (!('bannerUrl' in data) || (data.bannerUrl is string && data.bannerUrl.size() < 1000)) &&
             (!('hours' in data) || (data.hours is number && data.hours >= 0 && data.hours <= 10000)) &&
             (!('coachName' in data) || (data.coachName is string && data.coachName.size() < 150)) &&
             (!('studentsCount' in data) || (data.studentsCount is number && data.studentsCount >= 0));
    }
    
    function isValidEnrollment() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['userId', 'studentName', 'studentEmail', 'studentAvatar', 'courseId', 'progress', 'createdAt', 'completed', 'courseCompleted', 'completedAt', 'completionConfirmedBy', 'paymentOrderId', 'paymentStatus']) &&
             data.userId is string &&
             data.courseId is string &&
             (!('studentName' in data) || data.studentName is string) &&
             (!('studentEmail' in data) || data.studentEmail is string) &&
             (!('studentAvatar' in data) || data.studentAvatar is string) &&
             data.progress is number && data.progress >= 0 && data.progress <= 100 &&
             data.createdAt is timestamp &&
             (!('completed' in data) || data.completed is bool) &&
             (!('courseCompleted' in data) || data.courseCompleted is bool) &&
             (!('completedAt' in data) || data.completedAt is timestamp) &&
             (!('completionConfirmedBy' in data) || data.completionConfirmedBy is string);
    }
    
    function isValidJournal() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['userId', 'content', 'sentiment', 'createdAt']) &&
             data.userId is string &&
             data.content is string && data.content.size() > 0 && data.content.size() < 50000 &&
             data.createdAt is timestamp &&
             (!('sentiment' in data) || data.sentiment in ['positive', 'neutral', 'negative', 'unknown']);
    }

    function isValidReview() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['courseId', 'bookId', 'itemId', 'itemType', 'userId', 'rating', 'comment', 'status', 'createdAt']) &&
             ((('courseId' in data) && data.courseId is string) || (('bookId' in data) && data.bookId is string)) &&
             (!('itemId' in data) || data.itemId is string) &&
             (!('itemType' in data) || data.itemType in ['course', 'book']) &&
             data.userId is string &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.status in ['published', 'hidden'] &&
             data.createdAt is timestamp &&
             (!('comment' in data) || (data.comment is string && data.comment.size() <= 2000));
    }

    function isValidTransaction() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['userId', 'amount', 'type', 'courseId', 'coachId', 'commissionAmount', 'createdAt']) &&
             data.userId is string && data.amount is number && 
             data.type in ['course_purchase', 'coach_membership'] &&
             data.createdAt is timestamp &&
             (!('courseId' in data) || data.courseId is string) &&
             (!('coachId' in data) || data.coachId is string) &&
             (!('commissionAmount' in data) || data.commissionAmount is number);
    }

    function isValidCoupon() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['code', 'discountPercent', 'expiresAt', 'usageCount']) &&
             data.code is string && data.discountPercent is number &&
             (!('expiresAt' in data) || data.expiresAt is timestamp) &&
             (!('usageCount' in data) || data.usageCount is number);
    }

    function isValidB2B() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['name', 'adminEmail', 'licensesTotal', 'licensesUsed', 'createdAt']) &&
             data.name is string && data.adminEmail is string && 
             data.licensesTotal is number && data.createdAt is timestamp;
    }

    function isValidLog() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['adminId', 'action', 'targetId', 'details', 'createdAt']) &&
             data.adminId is string && data.action is string && data.createdAt is timestamp;
    }

    function isValidNotification() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['userId', 'title', 'message', 'type', 'read', 'createdAt']) &&
             data.userId is string && data.title is string && data.message is string &&
             data.type in ['system', 'message', 'course', 'ai'] &&
             data.read is bool && data.createdAt is timestamp;
    }

    function isValidAutomation() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['name', 'condition', 'thresholdDays', 'actionType', 'messageTemplate', 'active', 'ownerId', 'createdAt', 'processedCount', 'lastRunAt']) &&
             data.name is string && data.condition in ['inactivity', 'cart_abandonment', 'post_enrollment'] &&
             data.active is bool && data.createdAt is timestamp &&
             (!('processedCount' in data) || data.processedCount is number) &&
             (!('lastRunAt' in data) || data.lastRunAt is timestamp);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================
    
    // Sanitized public projection: no email, auth metadata, tenant IDs, or private notes.
    match /coachPublicProfiles/{coachId} {
      allow read: if resource.data.status == 'published';
      allow create, update: if isAdmin() || (isAuthenticated()
        && request.auth.uid == coachId
        && isApprovedCoach()
        && request.resource.data.uid == coachId
        && request.resource.data.status == 'published'
        && request.resource.data.approvalStatus == 'approved'
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'specialty', 'bio', 'specialties', 'languages', 'socialLinks', 'rating', 'studentCount', 'mediaItems', 'approvalStatus', 'status', 'updatedAt']));
      allow delete: if isAdmin() || (isAuthenticated()
        && request.auth.uid == coachId
        && (!exists(/databases/$(database)/documents/users/$(coachId))
          || get(/databases/$(database)/documents/users/$(coachId)).data.role != 'coach'
          || get(/databases/$(database)/documents/users/$(coachId)).data.approvalStatus != 'approved'));
    }

    match /users/{userId} {
      // Read: Public can see ALL coach profiles (needed for directory query). Users can read their own. Admins all.
      // And authenticated users can read profiles for chats etc.
      allow read: if isAdmin() || isKiraStaffAdmin() || isCurrentUser(userId) || isCompanyAdmin(resource.data.companyId);
      
      // Create: Users can create their own profile. Only admins can create an admin role.
      allow create: if isAuthenticated() && isCurrentUser(userId) && isValidUser() && 
                    ((request.resource.data.role == 'admin' && isAdmin()) ||
                     (request.resource.data.role in ['coach', 'alumno']));
      
      // Special: Allow coaches to create/refer new students
      allow create: if isApprovedCoach() && isValidUser() && request.resource.data.role == 'alumno';
                     
      // Update: Users can update their profile but NOT their role or approvalStatus. Admins can update anything.
      allow update: if isAuthenticated() && isValidUser() &&
                    ((isAdmin()) || 
                     (isCurrentUser(userId) && areImmutableFieldsUnchanged(['uid', 'email', 'role', 'approvalStatus', 'createdAt', 'staffPermissions', 'companyId', 'organizationId', 'tenantId', 'membershipStatus', 'membershipPaidAt', 'points', 'unlockedTools'])));
                     
      allow delete: if isAdmin();
    }
    
    // Public catalog items are visible only when published; only admins can manage inventory.
    match /books/{bookId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.currency in ['USD', 'BRL', 'EUR']
        && request.resource.data.status == 'published';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Private storage pointers and paid-book entitlements never appear in public catalog documents.
    match /bookAssets/{bookId} {
      allow read, write: if isAdmin();
    }

    match /bookEntitlements/{entitlementId} {
      allow read: if isAdmin() || isKiraStaffAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /membershipPlans/{planId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.status == 'published');
      allow create, update, delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isAuthenticated() && (isAdmin() || isKiraStaffAdmin() || resource.data.status == 'published' || (isAuthenticated() && resource.data.coachId == request.auth.uid));
      allow create: if isValidCourse() && (isAdmin() || (hasActiveCoachMembership() && request.resource.data.coachId == request.auth.uid && request.resource.data.status in ['draft', 'pending']));
      allow update: if isAuthenticated() && isValidCourse() && areImmutableFieldsUnchanged(['coachId', 'createdAt']) && 
                    (isAdmin() || (hasActiveCoachMembership() && resource.data.coachId == request.auth.uid && request.resource.data.status == resource.data.status));
      allow delete: if isAdmin();
    }
    
    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || isKiraStaffAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || (exists(/databases/$(database)/documents/courses/$(resource.data.courseId)) && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.coachId == request.auth.uid)));
      // Enrollment is a business entitlement, not a client-side payment flag.
      // Students may self-enroll only in published free courses. Paid enrollments
      // must be created by a trusted backend after a verified payment webhook.
      // Coaches cannot create enrollment entitlements from the client; admins may support operations.
      allow create: if isAuthenticated()
        && isValidEnrollment()
        && request.resource.data.progress == 0
        && (!('completed' in request.resource.data) || request.resource.data.completed == false)
        && (!('courseCompleted' in request.resource.data) || request.resource.data.courseCompleted == false)
        && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))
        && (
          isAdmin()
          || (
            request.resource.data.userId == request.auth.uid
            && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.status == 'published'
            && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.price <= 0
          )
        );
      allow update: if isAuthenticated() && isValidEnrollment() && areImmutableFieldsUnchanged(['userId', 'studentName', 'studentEmail', 'studentAvatar', 'courseId', 'createdAt', 'paymentOrderId', 'paymentStatus']) && 
                    (isAdmin() || (hasActiveCoachMembership() && exists(/databases/$(database)/documents/courses/$(resource.data.courseId)) && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.coachId == request.auth.uid));
      allow delete: if isAdmin();
    }
    
    // Journals are strictly private to their owner, including from coaches and administrators.
    match /journals/{journalId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidJournal() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isValidJournal()
                    && isCurrentUser(resource.data.userId)
                    && areImmutableFieldsUnchanged(['userId', 'createdAt']);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    match /sessions/{sessionId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.coachId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create: if isAuthenticated() && (isAdmin() || (hasActiveCoachMembership() && request.resource.data.coachId == request.auth.uid));
      allow update: if isAuthenticated() && (isAdmin() || (hasActiveCoachMembership() && resource.data.coachId == request.auth.uid && areImmutableFieldsUnchanged(['coachId', 'userId', 'createdAt'])));
      allow delete: if isAdmin() || (isApprovedCoach() && resource.data.coachId == request.auth.uid);
    }
    
    match /reviews/{reviewId} {
      allow read: if isAdmin() || resource.data.status == 'published' || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidReview() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isValidReview() && areImmutableFieldsUnchanged(['courseId', 'userId', 'createdAt']) &&
                    (isAdmin() || (isCurrentUser(resource.data.userId) && request.resource.data.status == resource.data.status));
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Financial ledger entries must be written by a trusted server/webhook (Admin SDK).
    // Client-side writes are disabled until the verified Stripe ledger endpoint is active.
    match /transactions/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Orders and entitlements are created only by trusted payment fulfillment.
    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /memberships/{membershipId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /purchases/{purchaseId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /paymentEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Backoffice CRM, academic operations and financial documents are server-only.
    // Express enforces role/assignment checks and writes immutable audit records.
    match /crmLeads/{id} { allow read, write: if false; }
    match /crmInteractions/{id} { allow read, write: if false; }
    match /courseGroups/{id} { allow read, write: if false; }
    match /groupSessions/{id} { allow read, write: if false; }
    match /attendance/{id} { allow read, write: if false; }
    match /assessments/{id} { allow read, write: if false; }
    match /invoices/{id} { allow read, write: if false; }
    match /paymentReminders/{id} { allow read, write: if false; }
    match /integrations/{id} { allow read, write: if false; }
    match /landingForms/{id} { allow read, write: if false; }
    match /webhookInbox/{id} { allow read, write: if false; }
    match /rolePermissions/{id} { allow read, write: if false; }
    match /dashboardKpis/{id} { allow read, write: if false; }
    // Snake_case aliases used by the academic aggregate model are server-only too.
    match /course_groups/{id} { allow read, write: if false; }
    match /group_sessions/{id} { allow read, write: if false; }
    match /student_performance/{id} { allow read, write: if false; }
    match /role_permissions/{id} { allow read, write: if false; }
    match /webhook_inbox/{id} { allow read, write: if false; }
    match /payment_reminders/{id} { allow read, write: if false; }
    match /dashboard_aggregates/{id} { allow read, write: if false; }
    match /outbox/{id} { allow read, write: if false; }

    // Payment configuration and ledger are managed only through trusted server APIs.
    // Secret ciphertext is never exposed to client-side Firestore listeners.
    match /paymentSettings/{id} { allow read, write: if false; }
    match /paymentGateways/{id} { allow read, write: if false; }
    match /paymentPlans/{id} { allow read, write: if false; }
    match /paymentCoupons/{id} { allow read, write: if false; }
    match /paymentAudit/{id} { allow read, write: if false; }
    match /config_audit/{id} { allow read, write: if false; }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /coupons/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /promotions/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /ai_coach_rules/{id} {
      allow read, write: if isAdmin();
    }

    match /b2b/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.companyId != null && isCompanyMember(resource.data.companyId));
      allow create, update, delete: if isAdmin();
    }

    // Tenant boundary: company admins can manage their own roster, while
    // employee wellbeing is exposed only through server-generated aggregates.
    match /companies/{companyId} {
      allow read: if isAdmin() || isCompanyMember(companyId);
      allow create, update, delete: if isAdmin();

      match /members/{memberId} {
        allow read: if isAdmin() || isCompanyAdmin(companyId);
        allow create, update, delete: if isAdmin();
      }

      match /wellbeingAggregates/{aggregateId} {
        allow read: if isAdmin() || isCompanyMember(companyId);
        allow create, update, delete: if false;
      }

      match /reports/{reportId} {
        allow read: if isAdmin() || isCompanyAdmin(companyId);
        allow create, update, delete: if false;
      }
    }

    match /logs/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false; // Logs should be immutable
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated() && (isAdmin() || (resource.data.participants is list && request.auth.uid in resource.data.participants));
      allow create: if isAuthenticated() && isValidMessage() && request.auth.uid == request.resource.data.senderId && (isAdmin() || hasActiveCoachMembership() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'alumno'));
      allow update, delete: if isAdmin();
    }

    match /contracts/{contractId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.coachId == request.auth.uid);
      allow create: if isAdmin() || hasActiveCoachMembership();
      allow update: if isAdmin() || (hasActiveCoachMembership() && resource.data.coachId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidNotification() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && (isAdmin() || (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool));
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /automations/{id} {
      allow read: if isAdmin() || isApprovedCoach();
      allow create, update, delete: if isAdmin() || hasActiveCoachMembership();
    }

    match /campaign_logs/{id} {
      allow read: if isAdmin() || isApprovedCoach();
      allow create: if isAdmin() || hasActiveCoachMembership();
      allow update, delete: if false;
    }

    match /contract_templates/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.coachId == request.auth.uid);
      allow create: if hasActiveCoachMembership() && request.resource.data.coachId == request.auth.uid;
      allow update, delete: if isAdmin() || (hasActiveCoachMembership() && resource.data.coachId == request.auth.uid);
    }

    match /course_activity/{id} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid)
        || (isApprovedCoach()
          && resource.data.courseId is string
          && exists(/databases/$(database)/documents/courses/$(resource.data.courseId))
          && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.coachId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /marketplace/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stats/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Certificate lifecycle: students submit requests; only the KIRA owner issues immutable credentials.
    match /certificateRequests/{requestId} {
      allow read: if isAdmin() || isKiraStaffAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.courseCompleted == true
        && request.resource.data.enrollmentId is string
        && exists(/databases/$(database)/documents/enrollments/$(request.resource.data.enrollmentId))
        && get(/databases/$(database)/documents/enrollments/$(request.resource.data.enrollmentId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/enrollments/$(request.resource.data.enrollmentId)).data.courseId == request.resource.data.courseId
        && get(/databases/$(database)/documents/enrollments/$(request.resource.data.enrollmentId)).data.status == 'completed'
        && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))
        && ((get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.price <= 0
             && request.resource.data.paymentRequired == false
             && request.resource.data.paid == true
             && request.resource.data.paymentStatus == 'not_required')
            || (get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.price > 0
             && request.resource.data.paymentRequired == true
             && request.resource.data.paid == false
             && request.resource.data.paymentStatus == 'pending_verification'));
      allow update, delete: if isKiraOwner();
    }

    match /certificates/{certificateId} {
      allow read: if isAdmin() || isKiraStaffAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      // All issuance and revocation writes are performed by the trusted server.
      allow create, update, delete: if false;
    }

    match /certificate_audit/{auditId} {
      allow read: if isAdmin() || isKiraStaffAdmin();
      allow create, update, delete: if false;
    }

    // Public projection contains only fields needed for verification.
    match /certificatePublic/{certificateId} {
      allow read: if resource.data.status in ['issued', 'revoked'];
      allow create, update, delete: if false;
    }

    match /urgent_escalations/{id} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
  }
}
