rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isKiraOwner() {
      return request.auth != null
        && request.auth.token.email == 'safeness.c.a@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Certificate branding, coach/admin signatures and issued PDFs are private.
    match /certificates/private/{allPaths=**} {
      allow read: if false;
      allow create, update: if isKiraOwner()
        && request.resource.size <= 5 * 1024 * 1024
        && (request.resource.contentType == 'image/png' || request.resource.contentType == 'application/pdf');
      allow delete: if isKiraOwner();
    }

    // Paid book files are never readable directly from the client. The API
    // checks the user's server-created entitlement and streams the file.
    match /books/admin/{ownerId}/{fileName} {
      allow read: if false;
      allow create, update: if isKiraOwner()
        && request.auth.uid == ownerId
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isKiraOwner() && request.auth.uid == ownerId;
    }

    // Public profile images and book covers are public assets; only their
    // authenticated owner/admin may upload or replace them.
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /covers/admin/{allPaths=**} {
      allow read: if true;
      allow create, update: if isKiraOwner()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isKiraOwner();
    }

    match /courses/{coachId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == coachId
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == coachId;
    }

    match /website/{allPaths=**} {
      allow read: if true;
      allow create, update: if isKiraOwner()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isKiraOwner();
    }

    match /promotions/{allPaths=**} {
      allow read: if true;
      allow create, update: if isKiraOwner()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isKiraOwner();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
